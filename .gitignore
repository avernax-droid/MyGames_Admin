cat << 'EOF' > /home/userverna/MyGames_Admin/.gitignore
# Ambientes Virtuais
venv/
env/
.venv/

# Variáveis de Ambiente e Segredos (CRÍTICO)
.env
.env.local

# Arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class

# Configurações de IDEs e Editores
.vscode/
.idea/
*.swp
*.txt
!carga_configs.sql
!requirements.txt

# Arquivos de log
*.log

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db

# Documentação Interna (Não enviar)
DOC/
EOF

cd /home/userverna/MyGames_Admin
git rm --cached gatilho_b.log gatilho_c1.log
git add .gitignore
git commit -m "chore: corrige regra *.log no .gitignore e remove logs locais do rastreamento"
git push origin main